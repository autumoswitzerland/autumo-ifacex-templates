###############################################################################
#
#  Title: Earnings Calendar
#  Version: 1.0
#
#  Notes:
#   Get historical and coming earnings release. EPS and Revenue in this endpoint
#   are non-GAAP, which means they are adjusted to exclude some one-time or
#   unusual items. This is the same data investors usually react to and talked
#   about on the media. Estimates are sourced from both sell-side and buy-side
#   analysts.
#   
#   API Docs: https://finnhub.io/docs/api
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 21:34:13 CET 2026
#
###############################################################################

formatVersion: 1

#-------- Overwritten Values ---------
general:
  files_folder: files

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - calendar/earnings

sources:
  - name: rest_in

    params:
      host: finnhub.io
      protocol: https
      port: "443"
      user: ""
      password: ""
      api_key: ""
      api_key_name: ""
      auth_method: none
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /api/v1/
      data_path: earningsCalendar
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "no"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: "from=2024-10-01&to=2024-11-01&token=YOUR_OWN_API_TOKEN"
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      calendar/earnings:
        fields:
          - date
          - epsActual
          - epsEstimate
          - hour
          - quarter
          - revenueActual
          - revenueEstimate
          - symbol
          - year

destinations:
  - name: console_out

    entities:
      calendar/earnings: {}

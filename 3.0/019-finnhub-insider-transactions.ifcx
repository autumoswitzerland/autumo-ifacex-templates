###############################################################################
#
#  Title: Insider Transactions
#  Version: 1.0
#
#  Notes:
#   Company insider transactions data sourced from Form 3,4,5, SEDI and relevant
#   companies' filings. This endpoint covers US, UK, Canada, Australia, India,
#   and all major EU markets. Limit to 100 transactions per API call.
#   
#   API Docs: https://finnhub.io/docs/api
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 21:35:03 CET 2026
#
###############################################################################

formatVersion: 1

#-------- Overwritten Values ---------
general:
  files_folder: files

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - stock/insider-transactions

sources:
  - name: rest_in

    params:
      host: finnhub.io
      protocol: https
      port: "443"
      user: ""
      password: ""
      api_key: ""
      api_key_name: ""
      auth_method: none
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /api/v1/
      data_path: data
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "no"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: "symbol=TSLA&token=YOUR_OWN_API_TOKEN"
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      stock/insider-transactions:
        fields:
          - change
          - currency
          - filingDate
          - id
          - isDerivative
          - name
          - share
          - source
          - symbol
          - transactionCode
          - transactionDate
          - transactionPrice

destinations:
  - name: console_out

    entities:
      stock/insider-transactions: {}

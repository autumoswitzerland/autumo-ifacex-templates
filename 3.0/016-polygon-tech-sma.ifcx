###############################################################################
#
#  Title: Technical Indicators - Simple Moving Average (SMA)
#  Version: 1.0
#
#  Notes:
#   Get the simple moving average (SMA) for a ticker symbol over a given time
#   range.
#   
#   API Docs: https://polygon.io/docs
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 21:30:03 CET 2026
#
###############################################################################

formatVersion: 1

general: {}

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - AAPL

sources:
  - name: rest_in

    params:
      host: api.polygon.io
      protocol: https
      port: ""
      user: ""
      password: ""
      api_key: YOUR_OWN_API_KEY
      api_key_name: apiKey
      auth_method: apikey
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /v1/indicators/sma/
      data_path: results.values
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "yes"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: "timespan=day&adjusted=true&window=50&series_type=close&order=desc&limit=10"
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      AAPL:
        fields:
          - timestamp
          - value

destinations:
  - name: console_out

    entities:
      AAPL: {}

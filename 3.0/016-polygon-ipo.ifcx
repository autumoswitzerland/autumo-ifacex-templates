###############################################################################
#
#  Title: IPOs
#  Version: 1.0
#
#  Notes:
#   The IPOs API provides access to detailed information about Initial Public
#   Offerings (IPOs), including both upcoming and historical events. With this
#   API, you can query for a comprehensive list of IPOs, along with key details
#   such as the issuer name, ticker symbol, ISIN, IPO date, number of shares
#   offered, expected price range, and final offering price. You can filter the
#   results by status to focus on new, rumors, pending, historical, and more.
#   
#   API Docs: https://polygon.io/docs
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 21:19:04 CET 2026
#
###############################################################################

formatVersion: 1

#-------- Overwritten Values ---------
general:
  files_folder: files

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - ipos

sources:
  - name: rest_in

    params:
      host: api.polygon.io
      protocol: https
      port: "443"
      user: ""
      password: ""
      api_key: YOUR_OWN_API_KEY
      api_key_name: apiKey
      auth_method: apikey
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /vX/reference/
      data_path: results
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "yes"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: ""
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      ipos:
        fields:
          - currency_code
          - final_issue_price
          - highest_offer_price
          - ipo_status
          - isin
          - issue_end_date
          - issue_start_date
          - issuer_name
          - last_updated
          - listing_date
          - lot_size
          - lowest_offer_price
          - max_shares_offered
          - min_shares_offered
          - primary_exchange
          - security_description
          - security_type
          - shares_outstanding
          - ticker
          - total_offer_size
          - us_code

destinations:
  - name: console_out

    entities:
      ipos: {}

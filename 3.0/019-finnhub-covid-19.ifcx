###############################################################################
#
#  Title: COVID-19
#  Version: 1.0
#
#  Notes:
#   Get real-time updates on the number of COVID-19 (Corona virus) cases in the
#   US with a state-by-state breakdown. Data is sourced from CDC and reputable
#   sources. You can also access this API here:
#   https://rapidapi.com/Finnhub/api/finnhub-real-time-covid-19.
#   
#   API Docs: https://finnhub.io/docs/api
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 21:33:24 CET 2026
#
###############################################################################

formatVersion: 1

#-------- Overwritten Values ---------
general:
  files_folder: files

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - covid19/us

sources:
  - name: rest_in

    params:
      host: finnhub.io
      protocol: https
      port: "443"
      user: ""
      password: ""
      api_key: ""
      api_key_name: ""
      auth_method: none
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /api/v1/
      data_path: .
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "no"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: token=YOUR_OWN_API_TOKEN
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      covid19/us:
        fields:
          - state
          - case
          - death
          - updated

destinations:
  - name: console_out

    entities:
      covid19/us: {}

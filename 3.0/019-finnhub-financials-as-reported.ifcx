###############################################################################
#
#  Title: Financials As Reported
#  Version: 1.0
#
#  Notes:
#   Get financials as reported. This data is available for bulk download on
#   Kaggle SEC Financials database:
#   https://www.kaggle.com/datasets/finnhub/reported-financials.
#   
#   API Docs: https://finnhub.io/docs/api
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 21:34:28 CET 2026
#
###############################################################################

formatVersion: 1

#-------- Overwritten Values ---------
general:
  files_folder: files

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - stock/financials-reported

sources:
  - name: rest_in

    params:
      host: finnhub.io
      protocol: https
      port: "443"
      user: ""
      password: ""
      api_key: ""
      api_key_name: ""
      auth_method: none
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /api/v1/
      data_path: data
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "no"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: "symbol=AAPL&token=YOUR_OWN_API_TOKEN"
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      stock/financials-reported:
        fields:
          - accessNumber
          - symbol
          - cik
          - year
          - startDate
          - endDate
          - filedDate
          - acceptedDate
          - report

destinations:
  - name: console_out

    entities:
      stock/financials-reported: {}

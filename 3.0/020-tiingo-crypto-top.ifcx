###############################################################################
#
#  Title: Crypto - Top-Of-Book Feed
#  Version: 1.0
#
#  Notes:
#   Tiingo connects to a variety of cryptocurrency exchanges to create a
#   consolidated top-of-book feed.
#   
#   API Docs: https://www.tiingo.com/documentation
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 22:01:37 CET 2026
#
###############################################################################

formatVersion: 1

general: {}

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - crypto/top

sources:
  - name: rest_in

    params:
      host: api.tiingo.com
      protocol: https
      port: ""
      user: ""
      password: ""
      api_key: YOUR_OWN_API_KEY
      api_key_name: token
      auth_method: apikey
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "yes"

    defaults:
      entities_url: /tiingo/
      data_path: .
      sub_path: ""
      query: ""
      field_path_access: "yes"
      allow_absent_fields: "no"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: tickers=btcusd
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      crypto/top:
        fields:
          - ticker
          - baseCurrency
          - quoteCurrency
          - "topOfBookData[0].quoteTimestamp"
          - "topOfBookData[0].lastSaleTimestamp"
          - "topOfBookData[0].bidSize"
          - "topOfBookData[0].bidPrice"
          - "topOfBookData[0].askSize"
          - "topOfBookData[0].askPrice"
          - "topOfBookData[0].lastSize"
          - "topOfBookData[0].lastSizeNotional"
          - "topOfBookData[0].lastPrice"
          - "topOfBookData[0].bidExchange"
          - "topOfBookData[0].askExchange"
          - "topOfBookData[0].lastExchange"

destinations:
  - name: console_out

    entities:
      crypto/top: {}

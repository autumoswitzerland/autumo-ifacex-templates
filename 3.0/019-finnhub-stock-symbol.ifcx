###############################################################################
#
#  Title: Stock Synbol
#  Version: 1.0
#
#  Notes:
#   List supported stocks. We use the following symbology to identify stocks on
#   Finnhub Exchange_Ticker.Exchange_Code. A list of supported exchange codes
#   can be found here:
#   https://docs.google.com/spreadsheets/d/1I3pBxjfXB056-g_JYf_6o3Rns3BV2kMGG1nCatb91ls/edit?gid=0#gid=0
#   
#   API Docs: https://finnhub.io/docs/api
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 21:37:06 CET 2026
#
###############################################################################

formatVersion: 1

#-------- Overwritten Values ---------
general:
  files_folder: files

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - stock/symbol

sources:
  - name: rest_in

    params:
      host: finnhub.io
      protocol: https
      port: "443"
      user: ""
      password: ""
      api_key: ""
      api_key_name: ""
      auth_method: none
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /api/v1/
      data_path: .
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "no"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: "exchange=US&mic=XNYS&token=YOUR_OWN_API_TOKEN"
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      stock/symbol:
        fields:
          - currency
          - description
          - displaySymbol
          - figi
          - mic
          - shareClassFIGI
          - symbol
          - symbol2
          - type

destinations:
  - name: console_out

    entities:
      stock/symbol: {}

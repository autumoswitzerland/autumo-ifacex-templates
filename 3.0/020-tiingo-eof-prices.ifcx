###############################################################################
#
#  Title: End-of-Day - Prices
#  Version: 1.0
#
#  Notes:
#   Tiingo's End-of-Day prices use a proprietary error checking framework to
#   help clean data feeds and also help catch missing corportate actions
#   (splits, dividends, and exchange listing changes). Most US Equity prices are
#   available at 5:30 PM EST, however exchanges may send corrections until 8 PM
#   EST. As we obtain corrections, we update prices throughout the evening.
#   Mutual Fund NAVs are available after 12 AM EST. The fields "open", "high",
#   "low", "close" will contain the NAV value for the given day.
#   
#   Both raw prices and adjusted prices are available. The adjustment
#   methodology follows the standard method set forth by "The Center for
#   Research in Security Prices" (CRSP). This methodology incorporates both
#   split and dividend adjustments.
#   
#   API Docs: https://www.tiingo.com/documentation
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 22:02:11 CET 2026
#
###############################################################################

formatVersion: 1

general: {}

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - aapl/prices

sources:
  - name: rest_in

    params:
      host: api.tiingo.com
      protocol: https
      port: ""
      user: ""
      password: ""
      api_key: YOUR_OWN_API_KEY
      api_key_name: token
      auth_method: apikey
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "yes"

    defaults:
      entities_url: /tiingo/daily/
      data_path: .
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "no"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: startDate=2019-01-02
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      aapl/prices:
        fields:
          - date
          - close
          - high
          - low
          - open
          - volume
          - adjClose
          - adjHigh
          - adjLow
          - adjOpen
          - adjVolume
          - divCash
          - splitFactor

destinations:
  - name: console_out

    entities:
      aapl/prices: {}

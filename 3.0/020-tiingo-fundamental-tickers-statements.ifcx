###############################################################################
#
#  Title: Fudamentals Tickert Statements
#  Version: 1.0
#
#  Notes:
#   Tiingo offers a fundamental data API via a third-party provider. Data goes
#   back over 20 years and covers US Equities and ADRs. We have used this
#   provider extensively over the years and found them to be reputable,
#   reliable, and accurate.
#   
#   API Docs: https://www.tiingo.com/documentation
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 22:11:25 CET 2026
#
###############################################################################

formatVersion: 1

general: {}

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - "fundamentals/msft/statements[cashFlow]"
  - "fundamentals/msft/statements[balanceSheet]"
  - "fundamentals/msft/statements[incomeStatement]"
  - "fundamentals/msft/statements[overview]"

sources:
  - name: rest_in

    params:
      host: api.tiingo.com
      protocol: https
      port: ""
      user: ""
      password: ""
      api_key: YOUR_OWN_API_KEY
      api_key_name: token
      auth_method: apikey
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "yes"

    defaults:
      entities_url: /tiingo/
      data_path: .
      sub_path: ""
      query: ""
      field_path_access: "yes"
      allow_absent_fields: "no"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: ""
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      "fundamentals/msft/statements[cashFlow]":
        fields:
          - date
          - year
          - quarter
          - "statementData.cashFlow[*].dataCode"
          - "statementData.cashFlow[*].value"
      "fundamentals/msft/statements[balanceSheet]":
        fields:
          - date
          - year
          - quarter
          - "statementData.balanceSheet[*].dataCode"
          - "statementData.balanceSheet[*].value"
      "fundamentals/msft/statements[incomeStatement]":
        fields:
          - date
          - year
          - quarter
          - "statementData.incomeStatement[*].dataCode"
          - "statementData.incomeStatement[*].value"
      "fundamentals/msft/statements[overview]":
        fields:
          - date
          - year
          - quarter
          - "statementData.overview[*].dataCode"
          - "statementData.overview[*].value"

destinations:
  - name: console_out

    entities:
      "fundamentals/msft/statements[cashFlow]": {}
      "fundamentals/msft/statements[balanceSheet]": {}
      "fundamentals/msft/statements[incomeStatement]": {}
      "fundamentals/msft/statements[overview]": {}

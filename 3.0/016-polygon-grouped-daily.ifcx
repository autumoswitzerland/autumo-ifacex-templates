###############################################################################
#
#  Title: Grouped Daily (Bars)
#  Version: 1.0
#
#  Notes:
#   Get the daily open, high, low, and close (OHLC) for the entire
#   stocks/equities markets.
#   
#   API Docs: https://polygon.io/docs
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 21:16:19 CET 2026
#
###############################################################################

formatVersion: 1

general: {}

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - us/market/stocks/2026-01-09

sources:
  - name: rest_in

    params:
      host: api.polygon.io
      protocol: https
      port: ""
      user: ""
      password: ""
      api_key: YOUR_OWN_API_KEY
      api_key_name: apiKey
      auth_method: apikey
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /v2/aggs/grouped/locale/
      data_path: results
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "yes"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: "adjusted=true&sort=asc"
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      us/market/stocks/2026-01-09:
        fields:
          - T
          - c
          - h
          - l
          - n
          - o
          - t
          - v
          - vw

destinations:
  - name: console_out

    entities:
      us/market/stocks/2026-01-09: {}

###############################################################################
#
#  Title: autumo ifaceX Web Tasks API
#  Version: 1.0
#
#  Notes:
#   List all tasks executing Interface Processors and show i.a. their execution
#   state.
#   
#   Note: If you run your ifaceX Server in HTTPS-mode, you would have to add the
#   certificate used to your executing JVM. The same with other HTTPS servers
#   that don't have a public certificate.
#   
#   See here:
#   https://magicmonster.com/kb/prg/java/ssl/pkix_path_building_failed/
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 23:59:59 CET 2026
#
###############################################################################

formatVersion: 1

general: {}

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - tasks/index.json

sources:
  - name: rest_in

    params:
      host: localhost
      protocol: http
      port: "8778"
      user: ""
      password: ""
      api_key: YOUR_OWN_API_KEY
      api_key_name: apiKey
      auth_method: apikey
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /
      data_path: tasks
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "no"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: "sort=id&direction=desc"
      fetchSize: "20"
      param_pageName: page
      param_offsetName: ""
      param_fetchSize: fetchsize
      pagination_path: paginator
      pagination_items_per_page: itemsPerPage
      pagination_items_total: itemsTotal
      pagination_last_page: lastPage
      pagination_after_id: ""

    entities:
      tasks/index.json:
        fields:
          - id
          - name
          - active
          - laststatus
          - lastexecuted

destinations:
  - name: console_out

    entities:
      tasks/index.json: {}

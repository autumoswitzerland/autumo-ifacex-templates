###############################################################################
#
#  Title: H1-B Visa Application
#  Version: 1.0
#
#  Notes:
#   Get a list of H1-B and Permanent visa applications for companies from the
#   DOL. The data is updated quarterly.
#   
#   API Docs: https://finnhub.io/docs/api
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 22:00:44 CET 2026
#
###############################################################################

formatVersion: 1

#-------- Overwritten Values ---------
general:
  files_folder: files

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - stock/visa-application

sources:
  - name: rest_in

    params:
      host: finnhub.io
      protocol: https
      port: "443"
      user: ""
      password: ""
      api_key: ""
      api_key_name: ""
      auth_method: none
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /api/v1/
      data_path: data
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "no"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: "symbol=AAPL&from=2021-01-01&to=2021-12-31&token=YOUR_OWN_API_TOKEN"
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      stock/visa-application:
        fields:
          - year
          - quarter
          - symbol
          - caseNumber
          - caseStatus
          - receivedDate
          - visaClass
          - jobTitle
          - socCode
          - fullTimePosition
          - beginDate
          - endDate
          - employerName
          - worksiteAddress
          - worksiteCity
          - worksiteCounty
          - worksiteState
          - worksitePostalCode
          - wageRangeFrom
          - wageUnitOfPay
          - wageLevel
          - h1bDependent

destinations:
  - name: console_out

    entities:
      stock/visa-application: {}

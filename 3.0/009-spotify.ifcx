###############################################################################
#
#  Title: Spotify API - Album & Tracks
#  Version: 1.0
#
#  Notes:
#   API Doc: https://developer.spotify.com/documentation/web-api/
#   
#   Based on simple REST principles, the Spotify Web API endpoints return JSON
#   metadata about music artists, albums, and tracks, directly from the Spotify
#   Data Catalogue.
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 20:33:19 CET 2026
#
###############################################################################

formatVersion: 1

general: {}

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - albums
  - tracks

sources:
  - name: rest_in

    params:
      host: api.spotify.com
      protocol: https
      port: ""
      user: YOUR_OWN_USER
      password: YOUR_OWN_PASSWORD
      api_key: ""
      api_key_name: ""
      auth_method: oauth-ba
      auth_url: /api/token
      auth_host: accounts.spotify.com
      auth_grant_type: client_credentials
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /
      data_path: items
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "no"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: market=CH
      fetchSize: "20"
      param_pageName: ""
      param_offsetName: offset
      param_fetchSize: limit
      pagination_path: ""
      pagination_items_per_page: limit
      pagination_items_total: total
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      albums:
        entities_url: /v1/artists/0GahP4xi6YHsQ7LL3dmjEd/
        fields:
          - name
      tracks:
        entities_url: /v1/albums/2cXvxgSUVnzOF9Ms6r46Ll/
        fields:
          - track_number
          - name
          - duration_ms
          - href

destinations:
  - name: console_out

    entities:
      albums: {}
      tracks: {}

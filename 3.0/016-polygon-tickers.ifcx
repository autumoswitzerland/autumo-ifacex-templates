###############################################################################
#
#  Title: Tickers
#  Version: 1.0
#
#  Notes:
#   Query all ticker symbols which are supported by Polygon.io. This API
#   currently includes Stocks/Equities, Indices, Forex, and Crypto.
#   
#   API Docs: https://polygon.io/docs
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 21:32:01 CET 2026
#
###############################################################################

formatVersion: 1

general: {}

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - tickers

sources:
  - name: rest_in

    params:
      host: api.polygon.io
      protocol: https
      port: ""
      user: ""
      password: ""
      api_key: YOUR_OWN_API_KEY
      api_key_name: apiKey
      auth_method: apikey
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /v3/reference/
      data_path: results
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "yes"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: "active=true&limit=10"
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      tickers:
        fields:
          - active
          - cik
          - composite_figi
          - currency_name
          - last_updated_utc
          - locale
          - market
          - name
          - primary_exchange
          - share_class_figi
          - ticker
          - type

destinations:
  - name: console_out

    entities:
      tickers: {}

###############################################################################
#
#  Title: Saferpay - Management - Terminal Payment Methods
#  Version: 1.0
#
#  Notes:
#   Retrieves a list of all available payment methods for a terminal.
#   
#   API:
#   https://saferpay.github.io/jsonapi/#rest_customers_terminals_payment-methods
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 23:59:39 CET 2026
#
###############################################################################

formatVersion: 1

general: {}

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - payment-methods

sources:
  - name: rest_in

    params:
      host: test.saferpay.com
      protocol: https
      port: ""
      user: YOUR_OWN_USER
      password: YOUR_OWN_PASSWORD
      api_key: ""
      api_key_name: ""
      auth_method: basic
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /api/rest/customers/CUSTOMER_ID/terminals/TERMINAL_ID
      data_path: PaymentMethods
      sub_path: ""
      query: ""
      field_path_access: "yes"
      allow_absent_fields: "yes"
      absent_field_placeholder: ""
      additional_headers: "Saferpay-RequestId:33e8af17-35c1-4165-a343-c1c86a320f3b|Saferpay-ApiVersion:1.14"
      additional_params: ""
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      payment-methods:
        fields:
          - PaymentMethod
          - Currencies

destinations:
  - name: console_out

    entities:
      payment-methods: {}

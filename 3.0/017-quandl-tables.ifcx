###############################################################################
#
#  Title: Quandl - Tables
#  Version: 1.0
#
#  Notes:
#   API: https://docs.quandl.com/docs/getting-started
#   
#   Quandl has a vast collection of free and open data collected from a variety
#   of organizations: central banks, governments, multinational organizations
#   and more. You can use it without payment and with few restrictions.
#   
#   Some data on Quandl is premium and can only be accessed with a subscription.
#   Subscriptions are a la carte: You can subscribe to the individual premium
#   datasets you need and nothing more. Subscriptions can be canceled at any
#   time.
#   
#   All premium datasets benefit from Quandl\u2019s free data-usage features:
#   full API access, integration with our many libraries and tools, downloads in
#   any format, multiple export and visualization options, and more. Most
#   premium datasets come with extensive free samples.
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 21:31:38 CET 2026
#
###############################################################################

formatVersion: 1

general: {}

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - FUND.json

sources:
  - name: rest_in

    params:
      host: www.quandl.com
      protocol: https
      port: ""
      user: ""
      password: ""
      api_key: YOUR_OWN_API_KEY
      api_key_name: api_key
      auth_method: apikey
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /api/v3/datatables/ETFG/
      data_path: datatable
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "no"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: ticker=SPY
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      FUND.json:
        fields:
          - columns
          - data

destinations:
  - name: console_out

    entities:
      FUND.json: {}

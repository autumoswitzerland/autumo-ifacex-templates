###############################################################################
#
#  Title: Conditions
#  Version: 1.0
#
#  Notes:
#   List all conditions that Polygon.io uses.
#   
#   API Docs: https://polygon.io/docs
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 20:55:46 CET 2026
#
###############################################################################

formatVersion: 1

#-------- Overwritten Values ---------
general:
  files_folder: files

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - conditions

sources:
  - name: rest_in

    params:
      host: api.polygon.io
      protocol: https
      port: "443"
      user: ""
      password: ""
      api_key: YOUR_OWN_API_KEY
      api_key_name: apiKey
      auth_method: apikey
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /v3/reference/
      data_path: results
      sub_path: ""
      query: ""
      field_path_access: "yes"
      allow_absent_fields: "yes"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: limit=10
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      conditions:
        fields:
          - asset_class
          - data_types
          - id
          - name
          - sip_mapping
          - type
          - update_rules.consolidated.updates_high_low
          - update_rules.consolidated.updates_open_close
          - update_rules.consolidated.updates_volume
          - update_rules.market_center.updates_high_low
          - update_rules.market_center.updates_open_close
          - update_rules.market_center.updates_volume

destinations:
  - name: console_out

    entities:
      conditions: {}

###############################################################################
#
#  Title: Insider Sentiment
#  Version: 1.0
#
#  Notes:
#   Get insider sentiment data for US companies calculated using method
#   discussed here. The MSPR ranges from -100 for the most negative to 100 for
#   the most positive which can signal price changes in the coming 30-90 days.
#   
#   API Docs: https://finnhub.io/docs/api
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 21:34:45 CET 2026
#
###############################################################################

formatVersion: 1

#-------- Overwritten Values ---------
general:
  files_folder: files

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - stock/insider-sentiment

sources:
  - name: rest_in

    params:
      host: finnhub.io
      protocol: https
      port: "443"
      user: ""
      password: ""
      api_key: ""
      api_key_name: ""
      auth_method: none
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /api/v1/
      data_path: data
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "no"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: "symbol=TSLA&from=2015-01-01&to=2022-03-01&token=YOUR_OWN_API_TOKEN"
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      stock/insider-sentiment:
        fields:
          - symbol
          - year
          - month
          - change
          - mspr

destinations:
  - name: console_out

    entities:
      stock/insider-sentiment: {}

###############################################################################
#
#  Title: Daily Open/Close
#  Version: 1.0
#
#  Notes:
#   Get the open, close and afterhours prices of a stock symbol on a certain
#   date.
#   
#   API Docs: https://polygon.io/docs
#
#------------------------------------------------------------------------------
#
#  Author: autumo GmbH
#  Date: Wed Oct 28 20:56:14 CET 2026
#
###############################################################################

formatVersion: 1

general: {}

#-------- Reader ---------------------
sourceInterface: rest_in

#-------- Writers --------------------
destinationInterfaces:
  - console_out

#-------- Source Entities ------------
processSourceEntities:
  - AAPL/2026-01-09

sources:
  - name: rest_in

    params:
      host: api.polygon.io
      protocol: https
      port: ""
      user: ""
      password: ""
      api_key: YOUR_OWN_API_KEY
      api_key_name: apiKey
      auth_method: apikey
      auth_url: ""
      auth_host: ""
      auth_grant_type: ""
      auth_body: ""
      alt_data_conn: "no"

    defaults:
      entities_url: /v1/open-close/
      data_path: .
      sub_path: ""
      query: ""
      field_path_access: "no"
      allow_absent_fields: "yes"
      absent_field_placeholder: ""
      additional_headers: ""
      additional_params: adjusted=true
      fetchSize: ""
      param_pageName: ""
      param_offsetName: ""
      param_fetchSize: ""
      pagination_path: ""
      pagination_items_per_page: ""
      pagination_items_total: ""
      pagination_last_page: ""
      pagination_after_id: ""

    entities:
      AAPL/2026-01-09:
        fields:
          - afterHours
          - close
          - from
          - high
          - low
          - open
          - preMarket
          - status
          - symbol
          - volume

destinations:
  - name: console_out

    entities:
      AAPL/2026-01-09: {}
